# SCRIS Environment Configuration Example

# Server Environment
PORT=5000
NODE_ENV=development

# Database Connection
# For local SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/scris_db?schema=public"

# Authentication & Security
JWT_SECRET="change-this-to-a-strong-secret-in-production-scris-2026"
COOKIE_SECRET="change-this-to-a-strong-cookie-secret-in-production"
FRONTEND_URL="http://localhost:5173"

# Teacher Registration Access Key
TEACHER_INVITE_CODE="SCRIS-FACULTY-2026"

# Email Configuration (Nodemailer)
# Leave SMTP_HOST empty or SMTP_DRY_RUN=true for dry-run mode (emails logged to database without failing)
SMTP_DRY_RUN="true"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SCRIS Academic Notifications <notifications@scris.internal>"
